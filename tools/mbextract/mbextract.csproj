<Project Sdk="Microsoft.NET.Sdk">
  <!--
    MotionBridge 추출 도우미. CUE4Parse(FModel 이 쓰는 라이브러리)로 언리얼 컨테이너를 열어 애니메이션을 ActorX(PSA)로 내보낸다.
    빌드 (Windows, .NET 8 SDK):
      git clone --depth 1 --recursive https://github.com/FabianFG/CUE4Parse third_party/CUE4Parse
      dotnet publish tools/mbextract -c Release -r win-x64 --self-contained -p:PublishSingleFile=true -o tools/mbextract/out
    ※ CUE4Parse 의 API 는 버전마다 조금씩 바뀐다. Program.cs 는 특정 시점 기준으로 쓰였고 컴파일 검증을 못 했다.
       컴파일 오류가 나면 오류 메시지를 알려 주면 맞춰 고칠 수 있다.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>mbextract</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../third_party/CUE4Parse/CUE4Parse/CUE4Parse.csproj" />
    <ProjectReference Include="../../third_party/CUE4Parse/CUE4Parse-Conversion/CUE4Parse-Conversion.csproj" />
  </ItemGroup>
</Project>
